{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arena:route-coverage:1",
  "title": "Per-deck route coverage (Gate 3, v3.2)",
  "description": "Every produces-feature of the deck's included combos classified against the WIN-ROUTES rules (cache-first, per deck — no global sweeps). A deck whose combos are all unroutable gets a blocking warning.",
  "type": "object",
  "required": ["schema", "deck_id", "win_routes_version", "combos", "unroutable_features", "status"],
  "properties": {
    "schema": { "const": "arena.route-coverage/1" },
    "deck_id": { "type": "string" },
    "win_routes_version": { "type": "string" },
    "combos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "features", "direct_win"],
        "properties": {
          "id": { "type": "string" },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "category"],
              "properties": {
                "name": { "type": "string" },
                "category": { "enum": ["WIN_TRIGGER", "LETHAL", "RESOURCE", "GUARD", "TABLE_HAZARD", "BOARD_CONTROL", "LOCK_DISRUPTION", "UNROUTABLE"] },
                "routes": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "direct_win": { "type": "boolean", "description": "true when any feature is LETHAL or WIN_TRIGGER; false = resources only, payoff conversion required (the LethalityPlanner's job)." }
        }
      }
    },
    "unroutable_features": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["clean", "unroutable_flagged"] }
  },
  "additionalProperties": false
}
