{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arena:events:1",
  "title": "Arena event-log line",
  "description": "Schema for one JSONL line. Normative combo/route taxonomy from plan §5 v3.2: silence is never a valid record of a decision — combo_ignored and route_selected/route_rejected are mandatory at decision points.",
  "type": "object",
  "required": ["t"],
  "properties": {
    "t": {
      "enum": [
        "game_start", "game_end",
        "turn_begin", "life_change", "zone_change", "spell_cast",
        "combo_state", "combo_ready", "combo_ignored",
        "line_entered", "line_step", "line_aborted", "combo_shortcut",
        "route_selected", "route_rejected", "combo_stalled",
        "tutor_decision", "mulligan_decision"
      ]
    },
    "turn": { "type": "integer", "minimum": 0 },
    "seat": { "type": "integer", "minimum": 0, "maximum": 3 },
    "phase": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "t": { "const": "game_start" } } },
      "then": { "required": ["seats", "seed"],
        "properties": { "seats": { "type": "array", "items": { "type": "string" } }, "seed": { "type": "integer" } } } },
    { "if": { "properties": { "t": { "const": "game_end" } } },
      "then": { "required": ["win_condition"],
        "properties": { "winner_seat": { "type": "integer" }, "win_condition": { "type": "string" }, "combo_id": { "type": "string" }, "route": { "type": "string" } } } },
    { "if": { "properties": { "t": { "const": "combo_state" } } },
      "then": { "required": ["seat", "combo", "distance"],
        "properties": { "combo": { "type": "string" }, "distance": { "type": "integer", "minimum": 0 }, "ready": { "type": "boolean" }, "where": { "type": "array" }, "blocked_by": { "type": "array" } } } },
    { "if": { "properties": { "t": { "const": "combo_ready" } } },
      "then": { "required": ["seat", "combo", "window"],
        "properties": { "combo": { "type": "string" }, "window": { "type": "string" } } } },
    { "if": { "properties": { "t": { "const": "combo_ignored" } } },
      "then": { "required": ["seat", "combo", "reason"],
        "properties": { "combo": { "type": "string" },
          "reason": { "enum": ["patience_gate", "no_viable_route", "validation_failed", "threat_assessment", "mana_reserved"] } } } },
    { "if": { "properties": { "t": { "const": "line_entered" } } },
      "then": { "required": ["seat", "combo", "attempted_via", "entry_phase"],
        "properties": { "combo": { "type": "string" }, "binding": { "type": "string" },
          "attempted_via": { "enum": ["binding", "generic_fallback"] }, "entry_phase": { "type": "string" } } } },
    { "if": { "properties": { "t": { "const": "line_step" } } },
      "then": { "required": ["seat", "stage", "iteration"],
        "properties": { "stage": { "type": "string" }, "iteration": { "type": "integer", "minimum": 0 } } } },
    { "if": { "properties": { "t": { "const": "line_aborted" } } },
      "then": { "required": ["seat", "cause"],
        "properties": { "cause": { "enum": ["interaction", "validation", "engine_error"] }, "piece_lost": { "type": "string" } } } },
    { "if": { "properties": { "t": { "const": "combo_shortcut" } } },
      "then": { "required": ["seat", "combo", "iterations_proven", "bounded_product"],
        "properties": { "combo": { "type": "string" }, "iterations_proven": { "type": "integer", "minimum": 1 }, "bounded_product": { "type": "object" } } } },
    { "if": { "properties": { "t": { "const": "route_selected" } } },
      "then": { "required": ["seat", "route", "predicates"],
        "properties": { "route": { "type": "string" }, "predicates": { "type": "object" } } } },
    { "if": { "properties": { "t": { "const": "route_rejected" } } },
      "then": { "required": ["seat", "route", "failed_predicate"],
        "properties": { "route": { "type": "string" }, "failed_predicate": { "type": "string" }, "predicates": { "type": "object" } } } },
    { "if": { "properties": { "t": { "const": "combo_stalled" } } },
      "then": { "required": ["seat", "binding", "state_hash", "dump_path"],
        "properties": { "binding": { "type": "string" }, "rejected_routes": { "type": "array" }, "state_hash": { "type": "string" }, "dump_path": { "type": "string" } } } },
    { "if": { "properties": { "t": { "const": "tutor_decision" } } },
      "then": { "required": ["seat", "source", "chosen", "ranked"],
        "properties": { "source": { "type": "string" }, "chosen": { "type": "string" },
          "ranked": { "type": "array", "items": { "type": "object", "required": ["c", "score", "why"],
            "properties": { "c": { "type": "string" }, "score": { "type": "number" }, "why": { "type": "string" } } } } } } },
    { "if": { "properties": { "t": { "const": "mulligan_decision" } } },
      "then": { "required": ["seat", "decision", "reason"],
        "properties": { "decision": { "enum": ["keep", "mulligan"] }, "hand_distance": { "type": "object" }, "reason": { "type": "string" } } } }
  ]
}
