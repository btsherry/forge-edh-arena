{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arena:combos:1",
  "title": "Deck combo artifact (Gate 3)",
  "description": "Included combos only (every piece in the 99+commander) — runtime tutor/tracking data. Almost-included combos are deckbuilding advice and live in advisory-combos.json, never here.",
  "type": "object",
  "required": ["schema", "deck_id", "deck_hash", "spellbook_snapshot", "combos"],
  "properties": {
    "schema": { "const": "arena.combos/1" },
    "deck_id": { "type": "string", "minLength": 1 },
    "deck_hash": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
    "spellbook_snapshot": { "type": "string", "description": "ISO date the raw snapshot was fetched." },
    "combos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "cards", "produces"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "cards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "zone_req"],
              "properties": {
                "name": { "type": "string" },
                "zone_req": { "enum": ["battlefield", "hand", "command", "graveyard", "library", "exile", "unknown"] },
                "must_be_commander": { "type": "boolean" }
              }
            }
          },
          "mana_needed": { "type": "string" },
          "prerequisites": {
            "type": "object",
            "properties": {
              "easy": { "type": "string" },
              "notable": { "type": "string" }
            }
          },
          "steps": { "type": "string" },
          "produces": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
