{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arena:deck-cards:1",
  "title": "Deck card-text package",
  "description": "v3.3: the full 99+commander with oracle text — the self-contained card-context package handed to the LLM in Gate 3.5 bindgen and Gate 3.6 stall autopsies. Extracted from the local Forge card DB at prep time; no network.",
  "type": "object",
  "required": ["schema", "deck_id", "cards", "unresolved"],
  "properties": {
    "schema": { "const": "arena.deck-cards/1" },
    "deck_id": { "type": "string", "minLength": 1 },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "qty", "zone"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "qty": { "type": "integer", "minimum": 1 },
          "zone": { "enum": ["commander", "main"] },
          "mana_cost": { "type": "string" },
          "type_line": { "type": "string" },
          "color_identity": { "type": "string" },
          "oracle_text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "description": "Names not found in the local card DB — Gate 2 blocks on these.",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
