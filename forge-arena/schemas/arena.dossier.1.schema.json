{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arena:dossier:1",
  "title": "Deck dossier index",
  "description": "v3.3: index written by `arena prep <deck>`; batch start validates freshness against this and refuses stale/missing dossiers.",
  "type": "object",
  "required": ["schema", "deck_id", "deck_hash", "created", "versions", "artifacts", "status"],
  "properties": {
    "schema": { "const": "arena.dossier/1" },
    "deck_id": { "type": "string", "minLength": 1 },
    "deck_hash": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
    "created": { "type": "string", "description": "ISO-8601 timestamp of the prep run." },
    "versions": {
      "type": "object",
      "required": ["schemas", "win_routes"],
      "properties": {
        "schemas": { "type": "string" },
        "win_routes": { "type": "string" },
        "binding_library": { "type": "string" },
        "route_library": { "type": "string", "description": "Effective route-library version at prep time (content hash over approved entries, or 'none'). DossierCheck refuses mismatches." },
        "spellbook_snapshot": { "type": "string" },
        "banlist": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Artifact name -> file, content-addressed.",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "status": {
      "type": "object",
      "required": ["lint", "implementability", "route_coverage"],
      "properties": {
        "lint": { "enum": ["pass", "fail", "not_run"] },
        "implementability": { "enum": ["pass", "fail", "not_run"] },
        "route_coverage": { "enum": ["clean", "unroutable_flagged", "blocked", "not_run"] },
        "sim_verified": { "enum": ["pass", "fail", "partial", "not_run"] },
        "goldfish": { "enum": ["pass", "fail", "not_run"] }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
