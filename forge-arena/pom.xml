<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-arena</artifactId>
    <name>Forge Arena</name>
    <description>Headless 4-player Commander batch harness with combo-aware AI (see forge-arena/docs/IMPLEMENTATION-PLAN.md)</description>

    <properties>
        <!--
          Arena tests run by default and are NOT disabled by the reactor's
          -DskipTests (see the surefire block below). Opting out is
          deliberate and explicit: -Darena.skip.tests=true.
        -->
        <arena.skip.tests>false</arena.skip.tests>
        <!-- BL-25 (2026-09-04): tests in the TestNG group `extended` (two-card
             seam widenings, the malformed-answer matrix, launcher tests) are
             skipped by the standard gate so its time does not grow; the FULL /
             release gate runs them with -Darena.excluded.groups=none. -->
        <arena.excluded.groups>extended</arena.excluded.groups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui-desktop</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <!-- scripts/batch.sh consumes this; generated in-reactor because
                             standalone dependency:build-classpath cannot resolve the
                             fork's ci-friendly ${revision} parent poms -->
                        <id>generate-runtime-classpath</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- bootstrap tests resolve ../forge-gui relative to the module basedir -->
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <!--
                      Always run arena tests even when the reactor build
                      passes -DskipTests for the forge deps: a green build
                      must never mean "the arena suite was skipped".

                      But that also made it IMPOSSIBLE to skip them, so
                      batch.sh — which only wants a compiled classpath — paid
                      the full ~4 minute suite on every launch. The dedicated
                      property keeps forge's -DskipTests from disabling us
                      while still giving a caller a deliberate way to opt out.
                    -->
                    <skipTests>${arena.skip.tests}</skipTests>
                    <!--
                      The suite plays real games, and a combo harness builds
                      very large boards on purpose, so the fork had grown to a
                      ~6GB unbounded G1 heap and started dying intermittently
                      inside G1ConcurrentMark::mark_in_next_bitmap - a JVM
                      crash under memory pressure, not a test failure. Bound
                      the heap and use the simpler collector: predictable
                      memory beats a heap that can grow until the GC folds.
                    -->
                    <!-- The parent's add-opens set is repeated here because a
                         child argLine REPLACES the parent's (BL-25). -->
                    <argLine>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.time=ALL-UNNAMED
                        --add-opens java.base/java.text=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --add-opens java.base/java.util.regex=ALL-UNNAMED
                        --add-opens java.base/java.util.stream=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.desktop/javax.imageio.spi=ALL-UNNAMED
                        -Xmx4g -XX:+UseParallelGC
                    </argLine>
                    <excludedGroups>${arena.excluded.groups}</excludedGroups>
                    <systemPropertyVariables>
                        <!-- harness-boil B1 (2026-08-28): E2E mailbox tests
                             stop paying live-game pacing. Live launches never
                             set this property and keep the 75ms default. -->
                        <arena.mailbox.poll.ms>5</arena.mailbox.poll.ms>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
